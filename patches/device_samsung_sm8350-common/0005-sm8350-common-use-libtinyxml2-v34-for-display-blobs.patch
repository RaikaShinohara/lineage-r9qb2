From 68bdf29adc9b8a5800eb74a9ac8a815d1a59b460 Mon Sep 17 00:00:00 2001
From: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
Date: Mon, 16 Nov 2026 15:09:09 +0000
Subject: [PATCH 5/7] sm8350-common: use libtinyxml2-v34 for display blobs

---
 common.mk        |  3 ++-
 extract-files.py | 10 ++++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/common.mk b/common.mk
index 6d471c8..474870e 100644
--- a/common.mk
+++ b/common.mk
@@ -444,7 +444,8 @@ PRODUCT_PACKAGES += \
 
 # VNDK
 PRODUCT_PACKAGES += \
-    libcrypto-v33
+    libcrypto-v33 \
+    libtinyxml2-v34
 
 # Weaver
 PRODUCT_PACKAGES += \
diff --git a/extract-files.py b/extract-files.py
index dbe19f6..c21da90 100755
--- a/extract-files.py
+++ b/extract-files.py
@@ -49,6 +49,16 @@ blob_fixups: blob_fixups_user_type = {
         .add_needed('libcrypto_shim.so'),
     ('vendor/lib64/mediadrm/libwvdrmengine.so', 'vendor/lib64/libwvhidl.so'): blob_fixup()
         .add_needed('libcrypto_shim.so'),
+    # La tinyxml2 v11 de Android 16 rompe la ABI: el composer muere en
+    # StcOrderParserImpl::Init y surfaceflinger no llega a arrancar
+    (
+        'vendor/lib/libdpps.so',
+        'vendor/lib64/libdpps.so',
+        'vendor/lib64/liblearningmodule.so',
+        'vendor/lib/libsnapdragoncolor-manager.so',
+        'vendor/lib64/libsnapdragoncolor-manager.so',
+    ): blob_fixup()
+        .replace_needed('libtinyxml2.so', 'libtinyxml2-v34.so'),
 }  # fmt: skip
 
 module = ExtractUtilsModule(
