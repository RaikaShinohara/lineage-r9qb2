Subject: [PATCH 2/7] sm8350-common: fix build on lineage-23.2

---
 common.mk             | 5 +----
 extract-files.py      | 1 -
 proprietary-files.txt | 4 ++++
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/common.mk b/common.mk
index 7c19d51..6d471c8 100644
--- a/common.mk
+++ b/common.mk
@@ -215,9 +215,6 @@ PRODUCT_PACKAGES += \
