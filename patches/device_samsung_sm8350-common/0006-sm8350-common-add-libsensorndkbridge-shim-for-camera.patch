From eb6e278088fe71c69430b856375897aeeed62728 Mon Sep 17 00:00:00 2001
From: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
Date: Mon, 16 Nov 2026 21:34:22 +0000
Subject: [PATCH 6/7] sm8350-common: add libsensorndkbridge shim for camera

---
 common.mk                            |  1 +
 shims/libsensorndkbridge/ALooper.cpp | 20 ++++++++++++++++++++
 shims/libsensorndkbridge/Android.bp  |  8 ++++++++
 3 files changed, 29 insertions(+)
 create mode 100644 shims/libsensorndkbridge/ALooper.cpp
 create mode 100644 shims/libsensorndkbridge/Android.bp

diff --git a/common.mk b/common.mk
index 474870e..1a5f75a 100644
--- a/common.mk
+++ b/common.mk
@@ -146,6 +146,7 @@ PRODUCT_PACKAGES += \
     libdl.vendor \
     libui_shim.vendor \
     libhidlbase_shim_sm8350.vendor \
+    libsensorndkbridge_shim \
     android.hardware.camera.device@3.6.vendor \
     android.hardware.camera.provider@2.5.vendor \
     android.hardware.camera.provider@2.6.vendor \
diff --git a/shims/libsensorndkbridge/ALooper.cpp b/shims/libsensorndkbridge/ALooper.cpp
new file mode 100644
index 0000000..0e8ea2e
--- /dev/null
+++ b/shims/libsensorndkbridge/ALooper.cpp
@@ -0,0 +1,20 @@
+#include "ALooper.h"
+
+// Samsung's libsensorndkbridge gives the camera its own loopers instead of
+// the global ALooper_prepare one (libsensorlistener, libvdis_core, libhypermotion_core)
+extern "C" {
+
+ALooper* ALooper_forCamera() {
+    return new ALooper;
+}
+
+int ALooper_pollOnce_camera(ALooper* looper, int timeoutMillis, int* outFd, int* outEvents,
+                            void** outData) {
+    return looper->pollOnce(timeoutMillis, outFd, outEvents, outData);
+}
+
+void ALooper_release_forCamera(ALooper* looper) {
+    delete looper;
+}
+
+}
diff --git a/shims/libsensorndkbridge/Android.bp b/shims/libsensorndkbridge/Android.bp
new file mode 100644
index 0000000..5b93e3a
--- /dev/null
+++ b/shims/libsensorndkbridge/Android.bp
@@ -0,0 +1,8 @@
+cc_library_shared {
+    name: "libsensorndkbridge_shim",
+    header_libs: ["libbase_headers"],
+    shared_libs: ["libsensorndkbridge", "libutils"],
+    include_dirs: ["frameworks/hardware/interfaces/sensorservice/libsensorndkbridge"],
+    srcs: ["ALooper.cpp"],
+    vendor: true,
+}
