From b663e5d244df1d5358863d102d698d814a2f9876 Mon Sep 17 00:00:00 2001
From: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
Date: Mon, 16 Nov 2026 17:13:08 +0000
Subject: [PATCH 13/18] r9q: also install init.r9q2.rc

---
 device.mk          |  3 ++-
 rootdir/Android.mk | 10 ++++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/device.mk b/device.mk
index 7777071..7bb0d0e 100644
--- a/device.mk
+++ b/device.mk
@@ -26,7 +26,8 @@ $(call inherit-product, vendor/samsung/r9q/r9q-vendor.mk)
 
 # Init files
 PRODUCT_PACKAGES += \
-    init.r9q.rc
+    init.r9q.rc \
+    init.r9q2.rc
 
 # Audio
 PRODUCT_COPY_FILES += \
diff --git a/rootdir/Android.mk b/rootdir/Android.mk
index 79824ab..bed68ad 100644
--- a/rootdir/Android.mk
+++ b/rootdir/Android.mk
@@ -9,3 +9,13 @@ LOCAL_MODULE_CLASS := ETC
 LOCAL_SRC_FILES    := etc/init.r9q.rc
 LOCAL_MODULE_PATH  := $(TARGET_OUT_VENDOR_ETC)/init/hw
 include $(BUILD_PREBUILT)
+
+# init_sm8350 sets the r9q2 codename on SM-G990B2 and init.target.rc imports
+# init.${ro.product.vendor.device}.rc
+include $(CLEAR_VARS)
+LOCAL_MODULE       := init.r9q2.rc
+LOCAL_MODULE_TAGS  := optional
+LOCAL_MODULE_CLASS := ETC
+LOCAL_SRC_FILES    := etc/init.r9q.rc
+LOCAL_MODULE_PATH  := $(TARGET_OUT_VENDOR_ETC)/init/hw
+include $(BUILD_PREBUILT)
