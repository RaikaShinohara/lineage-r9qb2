From: Icesito <113939920+Icesito68@users.noreply.github.com>
Date: Mon, 16 Nov 2026 21:34:22 +0000
Subject: [PATCH 17/18] =?UTF-8?q?r9q:=20arreglar=20la=20apertura=20de=20la?=
 =?UTF-8?q?=20c=C3=A1mara?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- com.qti.chi.override: SecUsecaseFastAec::SessionCbNotifyMessage bloquea
  un mutex que aún no existe (se crea tras Session::Initialize) y tumba el
  proveedor; la función solo registraba el aviso y pasa a no hacer nada.
- libsensorlistener, libvdis_core, libhypermotion_core: enlazar el shim
  de libsensorndkbridge; sin ALooper_*_forCamera CamX no carga
  com.ss.stats.aec y aborta al crear el pipeline.

Change-Id: Ie3d0227fdcfff9b480499ae6583fdb7f0ab45f0b
---
 extract-files.py      | 24 ++++++++++++++++++++++++
 proprietary-files.txt |  6 +++---
 2 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/extract-files.py b/extract-files.py
index f983feb..c51450c 100755
--- a/extract-files.py
+++ b/extract-files.py
@@ -40,9 +40,33 @@ blob_fixups: blob_fixups_user_type = {
         .add_needed('libhidlbase_shim_sm8350.so')
         .binary_regex_replace(b'_ZN7android8hardware22configureRpcThreadpoolEmb',
                               b'_ZN7android8hardware22configureRpcTh_pathcedEmb'),
+    # ALooper_*_forCamera de la libsensorndkbridge de Samsung; sin ellas CamX no
+    # carga com.ss.stats.aec y aborta al abrir cualquier cámara
+    (
+        'vendor/lib/libsensorlistener.so',
+        'vendor/lib/libvdis_core.so',
+        'vendor/lib64/libhypermotion_core.so',
+        'vendor/lib64/libsensorlistener.so',
+        'vendor/lib64/libvdis_core.so',
+    ): blob_fixup()
+        .add_needed('libsensorndkbridge_shim.so'),
     'vendor/lib64/hw/camera.qcom.so': blob_fixup()
         .binary_regex_replace(b'ro.boot.flash.locked', b'ro.camera.notify_nfc'),
     'vendor/lib64/hw/com.qti.chi.override.so': blob_fixup()
+        # SecUsecaseFastAec::Initialize crea su mutex después de Session::Initialize, y el
+        # hilo que finaliza el pipeline ya avisa antes: SessionCbNotifyMessage bloquea un
+        # mutex nulo y tumba el proveedor al abrir la cámara. El aviso solo se registraba
+        # en el log, así que la función pasa a volver sin hacer nada (GXF1)
+        .sig_replace(
+            'FF C3 00 D1 FD 7B 01 A9 FD 43 00 91 F4 4F 02 A9 34 00 40 F9 F3 03 00 AA 14 01 00 B4 88 02 40 F9 '
+            '2A 09 00 B0 4A A1 02 91 0B 5E 84 52 4C 01 0B 8B 1F 01 0C EB E1 00 00 54 28 08 40 B9 28 02 00 34 '
+            'F4 4F 42 A9 FD 7B 41 A9 FF C3 00 91 C0 03 5F D6 60 F4 94 D2 62 1B 00 F0 20 DC A5 F2 42 C0 13 91 '
+            'A0 76 C1 F2 E1 07 00 F9 20 58 FA F2 E1 03 08 AA 9A 74 04 94 E1 07 40 F9 28 08 40 B9 28 FE FF 35',
+            'FF C3 00 D1 FD 7B 01 A9 FD 43 00 91 F4 4F 02 A9 34 00 40 F9 F3 03 00 AA 14 01 00 B4 88 02 40 F9 '
+            '2A 09 00 B0 4A A1 02 91 0B 5E 84 52 4C 01 0B 8B 1F 01 0C EB E1 00 00 54 28 08 40 B9 1F 20 03 D5 '
+            'F4 4F 42 A9 FD 7B 41 A9 FF C3 00 91 C0 03 5F D6 60 F4 94 D2 62 1B 00 F0 20 DC A5 F2 42 C0 13 91 '
+            'A0 76 C1 F2 E1 07 00 F9 20 58 FA F2 E1 03 08 AA 9A 74 04 94 E1 07 40 F9 28 08 40 B9 F1 FF FF 17'
+        )
         .sig_replace(
             '80 06 40 F9 2D 79 00 94 80 01 00 34 A2 DB FF B0 C3 DD FF D0 A5 DC FF F0 E6 03 00 2A',
             '1F 20 03 D5 1F 20 03 D5 1F 20 03 D5 1F 20 03 D5 1F 20 03 D5 1F 20 03 D5 1F 20 03 D5'
