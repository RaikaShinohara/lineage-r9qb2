From b645c21e06448db81ffeccbf8afeaa575fb588a2 Mon Sep 17 00:00:00 2001
From: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
Date: Mon, 16 Nov 2026 15:09:09 +0000
Subject: [PATCH 09/18] r9q: shim libbase for the NFC HAL

---
 device.mk             | 3 ++-
 extract-files.py      | 3 +++
 proprietary-files.txt | 2 +-
 3 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/device.mk b/device.mk
index 14fcd55..7777071 100644
--- a/device.mk
+++ b/device.mk
@@ -35,7 +35,8 @@ PRODUCT_COPY_FILES += \
 
 # NFC
 PRODUCT_PACKAGES += \
-    android.hardware.nfc@1.2.vendor
+    android.hardware.nfc@1.2.vendor \
+    libbase_shim
 
 # Sensors
 PRODUCT_COPY_FILES += \
diff --git a/extract-files.py b/extract-files.py
index c82f154..48797f0 100755
--- a/extract-files.py
+++ b/extract-files.py
@@ -30,6 +30,9 @@ blob_fixups: blob_fixups_user_type = {
         'vendor/etc/init/vendor.samsung.hardware.camera.provider@4.0-service_64.rc',
     ): blob_fixup()
         .regex_replace(r'\n[ \t]*interface vendor\.samsung\.hardware\.[^\n]*', ''),
+    # android::base::Trim(const std::string&) is gone from Android 16's libbase
+    'vendor/lib64/nfc_nci_nxpsn.so': blob_fixup()
+        .add_needed('libbase_shim.so'),
     'vendor/lib64/hw/camera.qcom.so': blob_fixup()
         .binary_regex_replace(b'ro.boot.flash.locked', b'ro.camera.notify_nfc'),
     'vendor/lib64/hw/com.qti.chi.override.so': blob_fixup()
diff --git a/proprietary-files.txt b/proprietary-files.txt
index b2d478d..9cb260c 100644
--- a/proprietary-files.txt
+++ b/proprietary-files.txt
@@ -517,7 +517,7 @@ vendor/bin/hw/nxp.android.hardware.nfc@1.2-service
 vendor/etc/init/nxp.android.hardware.nfc@1.2-service.rc
 vendor/etc/libnfc-nxp.conf
 vendor/etc/nfc/libnfc-nxp_RF.conf
-vendor/lib64/nfc_nci_nxpsn.so;DISABLE_CHECKELF
+vendor/lib64/nfc_nci_nxpsn.so
 vendor/lib64/vendor.samsung.hardware.nfc@2.0.so
 
 # Sensors
