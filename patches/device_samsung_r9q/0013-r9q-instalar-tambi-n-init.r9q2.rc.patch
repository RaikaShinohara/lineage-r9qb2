From 7211eedeaca11e2d5b9dace002f809c4d4e909e6 Mon Sep 17 00:00:00 2001
From: Icesito <113939920+Icesito68@users.noreply.github.com>
Date: Mon, 16 Nov 2026 17:13:08 +0000
Subject: [PATCH 13/18] =?UTF-8?q?r9q:=20instalar=20tambi=C3=A9n=20init.r9q?=
 =?UTF-8?q?2.rc?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

init_sm8350 pone ro.product.vendor.device=r9q2 en el SM-G990B2 e
init.target.rc importa init.${ro.product.vendor.device}.rc, así que
init.r9q.rc no se cargaba (ni la carga de wlan.ko ni el resto).
Change-Id: I1ea64e914165f373c2f2e69a038c3071fbce59cd
---
 device.mk          |  3 ++-
 rootdir/Android.mk | 10 ++++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/device.mk b/device.mk
index 7777071..7bb0d0e 100644
--- a/device.mk
+++ b/device.mk
@@ -26,7 +26,8 @@ $(call inherit-product, vendor/samsung/r9q/r9q-vendor.mk)
 
 # Init files
 PRODUCT_PACKAGES += \
-    init.r9q.rc
+    init.r9q.rc \
+    init.r9q2.rc
 
 # Audio
 PRODUCT_COPY_FILES += \
diff --git a/rootdir/Android.mk b/rootdir/Android.mk
index 79824ab..a0217a9 100644
--- a/rootdir/Android.mk
+++ b/rootdir/Android.mk
@@ -9,3 +9,13 @@ LOCAL_MODULE_CLASS := ETC
 LOCAL_SRC_FILES    := etc/init.r9q.rc
 LOCAL_MODULE_PATH  := $(TARGET_OUT_VENDOR_ETC)/init/hw
 include $(BUILD_PREBUILT)
+
+# init_sm8350 da al SM-G990B2 el codename r9q2 y init.target.rc importa
+# init.${ro.product.vendor.device}.rc
+include $(CLEAR_VARS)
+LOCAL_MODULE       := init.r9q2.rc
+LOCAL_MODULE_TAGS  := optional
+LOCAL_MODULE_CLASS := ETC
+LOCAL_SRC_FILES    := etc/init.r9q.rc
+LOCAL_MODULE_PATH  := $(TARGET_OUT_VENDOR_ETC)/init/hw
+include $(BUILD_PREBUILT)
