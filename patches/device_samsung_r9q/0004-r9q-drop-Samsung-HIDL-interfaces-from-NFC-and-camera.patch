From e44c00d03c90b416fc528e57e825ecc6cfbaef20 Mon Sep 17 00:00:00 2001
From: RaikaShinohara <321751277+RaikaShinohara@users.noreply.github.com>
Date: Mon, 16 Nov 2026 08:16:27 +0000
Subject: [PATCH 04/18] r9q: drop Samsung HIDL interfaces from NFC and camera
 rc

---
 extract-files.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/extract-files.py b/extract-files.py
index d11191b..c82f154 100755
--- a/extract-files.py
+++ b/extract-files.py
@@ -23,6 +23,13 @@ namespace_imports = [
 
 
 blob_fixups: blob_fixups_user_type = {
+    # Samsung HIDL interfaces have no hidl_interface in the build, so host_init_verifier
+    # rejects them. The services still register at boot with class hal
+    (
+        'vendor/etc/init/nxp.android.hardware.nfc@1.2-service.rc',
+        'vendor/etc/init/vendor.samsung.hardware.camera.provider@4.0-service_64.rc',
+    ): blob_fixup()
+        .regex_replace(r'\n[ \t]*interface vendor\.samsung\.hardware\.[^\n]*', ''),
     'vendor/lib64/hw/camera.qcom.so': blob_fixup()
         .binary_regex_replace(b'ro.boot.flash.locked', b'ro.camera.notify_nfc'),
     'vendor/lib64/hw/com.qti.chi.override.so': blob_fixup()
