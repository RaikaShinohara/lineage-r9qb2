From 385eef8a0904619903f91fd1eed7074c8ecd288d Mon Sep 17 00:00:00 2001
From: Icesito <113939920+Icesito68@users.noreply.github.com>
Date: Mon, 16 Nov 2026 21:24:00 +0000
Subject: [PATCH 11/12] epoll: backport de epoll_pwait2 para Android 16

BLASTBufferQueue espera las liberaciones de buffer con epoll_pwait2
(Linux 5.11). En 5.4 devuelve ENOSYS y systemui y las apps entran en un
bucle de errores que llena logd. Se implementa sobre el ep_poll en
milisegundos, redondeando el timeout hacia arriba.

Change-Id: Ib997585d10860e3d6682fc622439cb33e3e69e92
---
 arch/arm64/include/asm/unistd.h   |  2 +-
 arch/arm64/include/asm/unistd32.h |  2 +
 fs/eventpoll.c                    | 64 +++++++++++++++++++++++++++++++
 include/linux/compat.h            |  6 +++
 include/linux/syscalls.h          |  5 +++
 include/uapi/asm-generic/unistd.h |  4 +-
 kernel/sys_ni.c                   |  2 +
 7 files changed, 83 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/include/asm/unistd.h b/arch/arm64/include/asm/unistd.h
index b3b2019f8..86a9d7b3e 100644
--- a/arch/arm64/include/asm/unistd.h
+++ b/arch/arm64/include/asm/unistd.h
@@ -38,7 +38,7 @@
 #define __ARM_NR_compat_set_tls		(__ARM_NR_COMPAT_BASE + 5)
 #define __ARM_NR_COMPAT_END		(__ARM_NR_COMPAT_BASE + 0x800)
 
-#define __NR_compat_syscalls		441
+#define __NR_compat_syscalls		442
 #endif
 
 #define __ARCH_WANT_SYS_CLONE
diff --git a/arch/arm64/include/asm/unistd32.h b/arch/arm64/include/asm/unistd32.h
index 52879c7aa..28d24d4b6 100644
--- a/arch/arm64/include/asm/unistd32.h
+++ b/arch/arm64/include/asm/unistd32.h
@@ -881,6 +881,8 @@ __SYSCALL(__NR_pidfd_open, sys_pidfd_open)
 __SYSCALL(__NR_clone3, sys_clone3)
 #define __NR_process_madvise 440
 __SYSCALL(__NR_process_madvise, sys_process_madvise)
+#define __NR_epoll_pwait2 441
+__SYSCALL(__NR_epoll_pwait2, compat_sys_epoll_pwait2)
 
 /*
  * Please add new compat syscalls above this comment and update
diff --git a/fs/eventpoll.c b/fs/eventpoll.c
index f2f92e3ec..31c2fd1c0 100644
--- a/fs/eventpoll.c
+++ b/fs/eventpoll.c
@@ -2366,7 +2366,71 @@ SYSCALL_DEFINE6(epoll_pwait, int, epfd, struct epoll_event __user *, events,
 	return error;
 }
 
+/*
+ * Backport de epoll_pwait2 (Linux 5.11), que Android 16 usa en BLASTBufferQueue.
+ * El ep_poll de 5.4 trabaja en milisegundos: el timeout se redondea hacia arriba.
+ */
+static int epoll_timespec_to_ms(const struct __kernel_timespec __user *timeout)
+{
+	struct timespec64 ts;
+	s64 ms;
+
+	if (!timeout)
+		return -1;
+	if (get_timespec64(&ts, timeout))
+		return -EFAULT;
+	if (!timespec64_valid(&ts))
+		return -EINVAL;
+
+	ms = ts.tv_sec * MSEC_PER_SEC + DIV_ROUND_UP(ts.tv_nsec, NSEC_PER_MSEC);
+	return ms > INT_MAX ? INT_MAX : (int)ms;
+}
+
+SYSCALL_DEFINE6(epoll_pwait2, int, epfd, struct epoll_event __user *, events,
+		int, maxevents, const struct __kernel_timespec __user *, timeout,
+		const sigset_t __user *, sigmask, size_t, sigsetsize)
+{
+	int error, ms;
+
+	ms = epoll_timespec_to_ms(timeout);
+	if (ms < -1)
+		return ms;
+
+	error = set_user_sigmask(sigmask, sigsetsize);
+	if (error)
+		return error;
+
+	error = do_epoll_wait(epfd, events, maxevents, ms);
+	restore_saved_sigmask_unless(error == -EINTR);
+
+	return error;
+}
+
 #ifdef CONFIG_COMPAT
+COMPAT_SYSCALL_DEFINE6(epoll_pwait2, int, epfd,
+			struct epoll_event __user *, events,
+			int, maxevents,
+			const struct __kernel_timespec __user *, timeout,
+			const compat_sigset_t __user *, sigmask,
+			compat_size_t, sigsetsize)
+{
+	long err;
+	int ms;
+
+	ms = epoll_timespec_to_ms(timeout);
+	if (ms < -1)
+		return ms;
+
+	err = set_compat_user_sigmask(sigmask, sigsetsize);
+	if (err)
+		return err;
+
+	err = do_epoll_wait(epfd, events, maxevents, ms);
+	restore_saved_sigmask_unless(err == -EINTR);
+
+	return err;
+}
+
 COMPAT_SYSCALL_DEFINE6(epoll_pwait, int, epfd,
 			struct epoll_event __user *, events,
 			int, maxevents, int, timeout,
