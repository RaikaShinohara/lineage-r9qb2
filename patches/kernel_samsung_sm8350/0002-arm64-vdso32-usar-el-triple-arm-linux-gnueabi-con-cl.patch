From 5ccd5dc468dcf7803c8db67d596fa47e01d96f7d Mon Sep 17 00:00:00 2001
From: Icesito <113939920+Icesito68@users.noreply.github.com>
Date: Sun, 15 Nov 2026 20:43:35 +0000
Subject: [PATCH 02/12] arm64: vdso32: usar el triple arm-linux-gnueabi con
 clang

El prefijo arm-linux-androidkernel- de LineageOS da un triple que clang 19+ rechaza.
Change-Id: Id9e75289e3a61e2d7ec5c260b8cd5fa20a213b76
---
 arch/arm64/kernel/vdso32/Makefile | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/kernel/vdso32/Makefile b/arch/arm64/kernel/vdso32/Makefile
index 3e8490769..2fac9dfc6 100644
--- a/arch/arm64/kernel/vdso32/Makefile
+++ b/arch/arm64/kernel/vdso32/Makefile
@@ -13,7 +13,7 @@ ifeq ($(CONFIG_CC_IS_CLANG), y)
 COMPAT_GCC_TOOLCHAIN_DIR := $(dir $(shell which $(CROSS_COMPILE_COMPAT)elfedit))
 COMPAT_GCC_TOOLCHAIN := $(realpath $(COMPAT_GCC_TOOLCHAIN_DIR)/..)
 
-CC_COMPAT_CLANG_FLAGS := --target=$(notdir $(CROSS_COMPILE_COMPAT:%-=%))
+CC_COMPAT_CLANG_FLAGS := --target=arm-linux-gnueabi
 CC_COMPAT_CLANG_FLAGS += --prefix=$(COMPAT_GCC_TOOLCHAIN_DIR)
 CC_COMPAT_CLANG_FLAGS += -no-integrated-as -Qunused-arguments
 ifneq ($(COMPAT_GCC_TOOLCHAIN),)
@@ -51,7 +51,7 @@ VDSO_CPPFLAGS += $(LINUXINCLUDE)
 # From top-level Makefile
 VDSO_CAFLAGS := $(VDSO_CPPFLAGS)
 ifneq ($(shell $(CC_COMPAT) --version 2>&1 | head -n 1 | grep clang),)
-VDSO_CAFLAGS += --target=$(notdir $(CROSS_COMPILE_COMPAT:%-=%))
+VDSO_CAFLAGS += --target=arm-linux-gnueabi
 endif
 
 VDSO_CAFLAGS += $(call cc32-option,-fno-PIE)
